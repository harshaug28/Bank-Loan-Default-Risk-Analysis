# Bank Loan Default Risk Analysis — .gitignore

# =====================
# Data files (too large for GitHub — download from Kaggle)
# =====================
data/raw/*.csv
data/raw/*.xlsx
data/cleaned/*.csv

# =====================
# Python
# =====================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
env/
venv/
.env
.venv
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
dist/
build/

# =====================
# Jupyter Notebooks
# =====================
.ipynb_checkpoints/
*.ipynb_checkpoints

# =====================
# Models (large files — use Git LFS if needed)
# =====================
models/*.pkl
models/*.joblib
# Uncomment below if using Git LFS:
# !models/random_forest_model.pkl

# =====================
# OS & Editor
# =====================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# =====================
# Outputs (generated — not tracked)
# =====================
outputs/*.png
outputs/*.pdf
# Keep placeholder
!outputs/.gitkeep

# =====================
# Tableau
# =====================
dashboard/*.twbx
# Too large — share via Tableau Public link instead

# =====================
# Logs
# =====================
*.log
logs/
